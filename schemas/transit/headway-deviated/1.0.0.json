{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blume.systems/transit/headway-deviated/1.0.0.json",
  "title": "HeadwayDeviated",
  "description": "Observed headway on a route diverged materially from schedule at a stop. Bunching and gapping are reported as the same event with opposite direction.",
  "type": "object",
  "properties": {
    "route_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Route the deviation was observed on."
    },
    "stop_ref": {
      "$ref": "https://schemas.blume.systems/common/asset_ref.json",
      "properties": {
        "class": {
          "enum": [
            "stop"
          ],
          "x-beb-enum": "open"
        }
      },
      "description": "Stop where headway was measured."
    },
    "direction": {
      "type": "string",
      "enum": [
        "bunching",
        "gapping"
      ],
      "x-beb-enum": "open",
      "description": "Sign of the deviation. Consumers MUST ignore unknown values."
    },
    "scheduled_headway_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Scheduled headway, seconds."
    },
    "actual_headway_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Observed headway, seconds."
    },
    "deviation_s": {
      "type": "integer",
      "description": "Signed difference, seconds."
    },
    "observed_at_stop": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "When the deviation was measured."
    },
    "provenance": {
      "$ref": "https://schemas.blume.systems/common/provenance.json",
      "description": "How the fact was produced. Required on every event."
    }
  },
  "required": [
    "route_id",
    "stop_ref",
    "direction",
    "scheduled_headway_s",
    "actual_headway_s",
    "provenance"
  ]
}
