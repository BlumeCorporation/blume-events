{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blume.systems/transit/stop-departed/1.0.0.json",
  "title": "StopDeparted",
  "description": "A vehicle departed a scheduled stop.",
  "type": "object",
  "properties": {
    "asset_ref": {
      "$ref": "https://schemas.blume.systems/common/asset_ref.json",
      "properties": {
        "class": {
          "enum": [
            "vehicle"
          ],
          "x-beb-enum": "open"
        }
      },
      "description": "Departing vehicle."
    },
    "stop_ref": {
      "$ref": "https://schemas.blume.systems/common/asset_ref.json",
      "properties": {
        "class": {
          "enum": [
            "stop"
          ],
          "x-beb-enum": "open"
        }
      },
      "description": "Stop departed from."
    },
    "route_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Route being worked."
    },
    "trip_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Trip being worked."
    },
    "departed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "When the vehicle departed."
    },
    "scheduled_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "Scheduled departure time."
    },
    "dwell_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds spent at the stop."
    },
    "delay_s": {
      "type": "integer",
      "description": "Signed seconds late. Negative is early."
    },
    "provenance": {
      "$ref": "https://schemas.blume.systems/common/provenance.json",
      "description": "How the fact was produced. Required on every event."
    }
  },
  "required": [
    "asset_ref",
    "stop_ref",
    "trip_id",
    "departed_at",
    "provenance"
  ]
}
