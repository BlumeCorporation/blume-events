{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blume.systems/traffic/incident-cleared/1.0.0.json",
  "title": "IncidentCleared",
  "description": "A previously declared incident was cleared. Terminal for the `incident_id`.",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "description": "Incident being cleared. Matches a prior incident-declared."
    },
    "cleared_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "When the incident was cleared."
    },
    "duration_s": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds between declaration and clearance."
    },
    "resolution": {
      "type": "string",
      "enum": [
        "resolved",
        "referred",
        "false-positive",
        "superseded"
      ],
      "x-beb-enum": "open",
      "description": "How the incident ended. Consumers MUST ignore unknown values."
    },
    "provenance": {
      "$ref": "https://schemas.blume.systems/common/provenance.json",
      "description": "How the fact was produced. Required on every event."
    }
  },
  "required": [
    "incident_id",
    "cleared_at",
    "resolution",
    "provenance"
  ]
}
