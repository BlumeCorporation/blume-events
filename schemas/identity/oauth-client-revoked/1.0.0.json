{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blume.systems/identity/oauth-client-revoked/1.0.0.json",
  "title": "OauthClientRevoked",
  "description": "A relying party's registration was revoked. Terminal for the client id; outstanding grants to it are revoked separately and per subject.",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "description": "Client that was revoked."
    },
    "reason": {
      "type": "string",
      "enum": [
        "operator",
        "compromise",
        "expiry",
        "superseded",
        "contract-end"
      ],
      "x-beb-enum": "open",
      "description": "Why the registration was revoked. Consumers MUST ignore unknown values."
    },
    "principal": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "description": "Principal that performed the revocation."
    },
    "revoked_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "When the registration was revoked."
    },
    "provenance": {
      "$ref": "https://schemas.blume.systems/common/provenance.json",
      "description": "How the fact was produced. Required on every event."
    }
  },
  "required": [
    "client_id",
    "reason",
    "principal",
    "revoked_at",
    "provenance"
  ]
}
